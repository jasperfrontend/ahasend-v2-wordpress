#. Name of the plugin
#: xolution-maildelivery.php src/Admin/SettingsPage.php:62 src/Admin/SettingsPage.php:193
msgid "Xolution MailDelivery"
msgstr "Xolution MailDelivery"

#. Description of the plugin
#: xolution-maildelivery.php src/Update/GitHubUpdater.php:79
msgid "Sends selected WordPress emails through the AhaSend API instead of the server's own mailer."
msgstr "Verstuurt geselecteerde WordPress-e-mails via de AhaSend-API in plaats van via de eigen mailer van de server."

